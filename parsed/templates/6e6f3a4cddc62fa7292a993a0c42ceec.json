{"components/common/navigation-menu":"<div class=\"twelve-mobile-top\">\n    <div class=\"twelve-mobile-logo\">{{> components/common/store-logo}}</div>\n    <button class=\"twelve-mobile-close\" type=\"button\" data-twelve-mobile-close aria-label=\"Close menu\">\n        <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6 6 18\"/></svg>\n    </button>\n</div>\n\n{{!-- The one dynamic navigation is moved into this slot on mobile. --}}\n<div class=\"twelve-mobile-body\" data-twelve-mobile-menu-slot></div>\n\n<div class=\"twelve-mobile-footer\">\n    <div class=\"twelve-mobile-selectors\">\n        {{#and language_selector language_selector.languages.length '>' 1}}\n            <details class=\"twelve-mobile-select\">\n                <summary aria-label=\"Language\"><span data-locale-code=\"{{language_selector.active_language_code}}\">{{language_selector.active_language_code}}</span></summary>\n                <ul>{{#each language_selector.languages}}<li><a href=\"{{switch_url}}\" data-locale-code=\"{{code}}\" {{#if is_active}}aria-current=\"true\"{{/if}}>{{code}}</a></li>{{/each}}</ul>\n            </details>\n        {{else}}\n            <span class=\"twelve-mobile-locale\">English</span>\n        {{/and}}\n        {{#or customer (unless settings.hide_price_from_guests)}}\n            {{#if currency_selector.currencies.length '>' 1}}\n                <details class=\"twelve-mobile-select\">\n                    <summary aria-label=\"Currency\">{{currency_selector.active_currency_code}}</summary>\n                    <ul>{{#each currency_selector.currencies}}<li><a href=\"{{{switch_url}}}\" data-currency-code=\"{{code}}\" {{#if cart_currency_switch_url}}data-cart-currency-switch-url=\"{{{cart_currency_switch_url}}}\"{{/if}} data-warning=\"Changing currency may affect your promotions. Continue?\" {{#if is_active}}aria-current=\"true\"{{/if}}>{{code}}</a></li>{{/each}}</ul>\n                </details>\n            {{else}}<span class=\"twelve-mobile-locale\">{{currency_selector.active_currency_code}}</span>{{/if}}\n        {{/or}}\n    </div>\n    <span class=\"twelve-mobile-cities\">NY &middot; LDN &middot; PAR</span>\n</div>\n","components/common/store-logo":"<a href=\"{{urls.home}}\" class=\"header-logo__link\" data-header-logo-link>\n    {{#if settings.store_logo.image}}\n        {{#if theme_settings.logo_size '===' 'original'}}\n        <img class=\"header-logo-image-unknown-size\"\n             src=\"{{getImage settings.store_logo.image 'logo_size'}}\"\n             alt=\"{{settings.store_logo.title}}\"\n             title=\"{{settings.store_logo.title}}\">\n        {{else}}\n        <div class=\"header-logo-image-container\">\n            <img class=\"header-logo-image\"\n                 src=\"{{getImage settings.store_logo.image 'logo_size'}}\"\n                 srcset=\"{{getImageSrcset1x2x settings.store_logo.image theme_settings.logo_size}}\"\n                 alt=\"{{settings.store_logo.title}}\"\n                 title=\"{{settings.store_logo.title}}\">\n        </div>\n        {{/if}}\n    {{else}}\n        {{#if theme_settings.twelve_use_wordmark}}\n            <img class=\"twelve-wordmark\" src=\"{{cdn 'assets/img/twelve-wordmark.png'}}\" width=\"900\" height=\"176\" alt=\"{{settings.store_logo.title}}\">\n        {{else}}\n            <span class=\"header-logo-text\">{{settings.store_logo.title}}</span>\n        {{/if}}\n    {{/if}}\n</a>\n"}