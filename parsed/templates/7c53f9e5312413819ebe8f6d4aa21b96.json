{"components/common/navigation":"<nav class=\"navUser twelve-tools\" aria-label=\"Customer tools\">\n    <ul class=\"navUser-section navUser-section--alt\">\n        <li class=\"navUser-item\">\n            <button class=\"navUser-action twelve-tool\" type=\"button\" id=\"quick-search-expand\" data-search=\"quickSearch\" aria-controls=\"quickSearch\" aria-expanded=\"false\" aria-label=\"Search\">\n                <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"6.5\"/><path d=\"M16 16l4.5 4.5\"/></svg>\n            </button>\n        </li>\n        <li class=\"navUser-item twelve-tool-desktop\">\n            <a class=\"navUser-action twelve-tool\" href=\"{{#if customer}}{{urls.account.index}}{{else}}{{urls.auth.login}}{{/if}}\" aria-label=\"Account\">\n                <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"8.5\" r=\"3.8\"/><path d=\"M4.8 20a7.2 7.2 0 0 1 14.4 0\"/></svg>\n            </a>\n        </li>\n        \n        <li class=\"navUser-item twelve-tool-desktop\">\n            <a class=\"navUser-action twelve-tool\" href=\"/?auth={{random 150 10}}-{{random 125 10}}#/shoppingLists\" aria-label=\"Wish Lists\">\n                <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M20.5 5.8c-2-2.1-5.4-1.8-8.5 1.3C8.9 4 5.5 3.7 3.5 5.8c-3.8 4 1.1 10 8.5 15 7.4-5 12.3-11 8.5-15Z\"/></svg>\n            </a>\n        </li>\n        \n        <li class=\"navUser-item navUser-item--cart\">\n            <a class=\"navUser-action twelve-tool\" data-cart-preview href=\"{{urls.cart}}\" aria-controls=\"cart-preview-dropdown\" aria-expanded=\"false\" aria-label=\"Cart with 0 items\">\n                <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 7h14l-1.2 13H6.2z\"/><path d=\"M9 9V6a3 3 0 0 1 6 0v3\"/></svg>\n                <span class=\"countPill cart-quantity\"></span>\n            </a>\n            <div class=\"twelve-cart-scrim\" data-twelve-cart-scrim></div>\n            <div class=\"dropdown-menu\" id=\"cart-preview-dropdown\" aria-hidden=\"true\"></div>\n        </li>\n    </ul>\n    <div class=\"dropdown dropdown--quickSearch\" id=\"quickSearch\" aria-hidden=\"true\" data-prevent-quick-search-close>\n        {{> components/common/quick-search name='nav-quick-search'}}\n    </div>\n</nav>\n","components/common/quick-search":"<div class=\"twelve-search-overlay\" data-pre-load=\"box\">\n    <form class=\"form\" data-url=\"{{urls.search}}\" data-quick-search-form>\n        <fieldset class=\"form-fieldset\">\n            <div class=\"form-field\">\n                <label class=\"is-srOnly\" for=\"{{name}}\">{{lang \"search.quick_search.input_label\"}}</label>\n                <svg class=\"twelve-search-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"6.5\"/><path d=\"M16 16l4.5 4.5\"/></svg>\n                <input class=\"form-input\"\n                       data-search-quick\n                       name=\"{{name}}\"\n                       id=\"{{name}}\"\n                       data-error-message=\"{{lang 'search.error.empty_field'}}\"\n                       placeholder=\"What are you making?\"\n                       autocomplete=\"off\"\n                >\n                <button class=\"twelve-search-close\" type=\"button\" data-drop-down-close aria-label=\"Close search\"><span aria-hidden=\"true\">&times;</span></button>\n            </div>\n        </fieldset>\n    </form>\n    <div class=\"twelve-search-content\">\n        <aside class=\"twelve-search-popular\">\n            <span class=\"twelve-search-label\">Popular</span>\n            <div class=\"twelve-search-tags\">\n                <button type=\"button\" data-twelve-search-term=\"Canvas tote\">Canvas tote</button>\n                <button type=\"button\" data-twelve-search-term=\"Rigid box\">Rigid box</button>\n                <button type=\"button\" data-twelve-search-term=\"Bottle\">Bottle</button>\n                <button type=\"button\" data-twelve-search-term=\"Ornament\">Ornament</button>\n                <button type=\"button\" data-twelve-search-term=\"Gift kit\">Gift kit</button>\n            </div>\n        </aside>\n        <div class=\"twelve-search-products\">\n            <p class=\"twelve-search-products-title\" data-twelve-search-title>Products · <em>Popular right now</em></p>\n            <div class=\"loadingOverlay\" data-twelve-search-loading style=\"display: none;\">&nbsp;</div>\n            <section class=\"quickSearchResults\" data-bind=\"html: results\"></section>\n        </div>\n    </div>\n    <p role=\"status\"\n       aria-live=\"polite\"\n       class=\"aria-description--hidden\"\n       data-search-aria-message-predefined-text=\"{{{lang 'search.results.quick_count_live'}}}\"\n    ></p>\n</div>\n"}