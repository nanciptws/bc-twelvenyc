{"components/common/footer":"{{#if banners.bottom}}\n    <div class=\"banners\" data-banner-location=\"bottom\">\n        {{#each (limit banners.bottom_metadata 1)}}\n            <div class=\"banner\" data-event-type=\"promotion\" data-entity-id=\"{{this.id}}\" data-name=\"{{this.banner-name}}\" data-position=\"{{this.location}}\"><div data-event-type=\"promotion-click\">{{{this.content}}}</div></div>\n        {{/each}}\n    </div>\n{{/if}}\n<footer class=\"twelve-footer\" role=\"contentinfo\">\n    <div class=\"twelve-footer-top\">\n        <div class=\"twelve-footer-brand\">\n            <span class=\"twelve-footer-wordmark\" role=\"img\" aria-label=\"Twelve\">TWELVE</span>\n            {{{region name=\"footer_store_info--global\"}}}\n            {{{region name=\"footer_country--global\"}}}\n        </div>\n        <section class=\"twelve-footer-column\">\n            <h2>{{{region name=\"footer_head_1--global\"}}}</h2><button type=\"button\" data-twelve-footer-toggle aria-expanded=\"false\">Shop <span aria-hidden=\"true\"></span></button>\n            <div data-twelve-footer-content>\n                {{{region name=\"footer_links_1--global\"}}}\n            </div>\n        </section>\n        <section class=\"twelve-footer-column\">\n            <h2>{{{region name=\"footer_head_2--global\"}}}</h2><button type=\"button\" data-twelve-footer-toggle aria-expanded=\"false\">Information <span aria-hidden=\"true\"></span></button>\n            <div data-twelve-footer-content>\n\n                {{{region name=\"footer_links_2--global\"}}}\n\n                <div style=\"margin: 20px 0;\">\n                    <a class=\"connect-with-us tooltip_hover_state\" href=\"mailto:elcsupport@twelvenyc.com\">\n                        <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" width=\"22\" height=\"22\"><path d=\"M3 6h18v12H3z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"></path><path d=\"M3 7l9 6 9-6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"></path></svg>\n                        <span>Techncial Support</span>\n                        <div class=\"tooltip_content_box\" style=\"left: 0;\">\n                            <p>elcsupport@twelvenyc.com</p>\n                        </div>\n                    </a>\n                </div>\n            </div>\n            \n        </section>\n        <section class=\"twelve-footer-column\">\n            <h2>{{{region name=\"footer_head_3--global\"}}}</h2><button type=\"button\" data-twelve-footer-toggle aria-expanded=\"false\">Follow <span aria-hidden=\"true\"></span></button>\n            <div data-twelve-footer-content>\n                {{{region name=\"footer_links_3--global\"}}}\n            </div>\n        </section>\n        <section class=\"twelve-footer-column twelve-footer-newsletter\">\n            <h2>{{{region name=\"footer_head_4--global\"}}}</h2><button type=\"button\" data-twelve-footer-toggle aria-expanded=\"false\">Stay Inspired <span aria-hidden=\"true\"></span></button>\n            <div data-twelve-footer-content>\n                {{{region name=\"footer_newsletter_1--global\"}}}\n                <form action=\"{{urls.subscribe.action}}\" method=\"post\">\n                    <input type=\"hidden\" name=\"action\" value=\"subscribe\"><input type=\"hidden\" name=\"nl_first_name\" value=\"bc\"><input type=\"hidden\" name=\"check\" value=\"1\">\n                    <label class=\"is-srOnly\" for=\"twelve-footer-email\">Email address</label><input id=\"twelve-footer-email\" name=\"nl_email\" type=\"email\" value=\"{{customer.email}}\" placeholder=\"you@company.com\" autocomplete=\"email\" required><button type=\"submit\" aria-label=\"Subscribe\">&rarr;</button>\n                </form>\n            </div>\n            {{{region name=\"footer_need_help--global\"}}}\n        </section>\n    </div>\n    <div class=\"twelve-footer-bar\"><div>\n        <span>&copy; {{moment format=\"YYYY\"}} Twelve NYC</span>\n            <nav aria-label=\"Legal\">\n                {{{region name=\"footer_links_5--global\"}}}\n            </nav>\n            <span>All prices EXW · shipping and duties excluded</span>\n    </div></div>\n    {{{region name=\"ssl_site_seal--global\"}}}\n</footer>\n\n"}