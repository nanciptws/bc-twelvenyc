{"components/common/channel-selector":"{{#if theme_settings.channels.length '>' 1}}\n<ul class=\"navUser-section\">\n    <li class=\"navUser-item\">\n        <a href=\"#\"\n           class=\"navUser-action navUser-action--channelSelector has-dropdown\"\n           data-dropdown=\"channelSelection\"\n           aria-controls=\"channelSelection\"\n           aria-expanded=\"false\"\n        >\n            {{#each theme_settings.channels}}\n                {{#if is_active}}\n                    {{lang 'common.channel' code=code}}\n                {{/if}}\n            {{/each}}\n            <i class=\"icon\" aria-hidden=\"true\">\n                <svg>\n                    <use href=\"#icon-chevron-down\"/>\n                </svg>\n            </i>\n        </a>\n        <ul class=\"dropdown-menu\" id=\"channelSelection\" data-dropdown-content aria-hidden=\"true\" tabindex=\"-1\">\n            {{#each theme_settings.channels}}\n                <li class=\"dropdown-menu-item\">\n                    <a href=\"{{{switch_url}}}\" data-channel-code=\"{{{code}}}\" data-warning=\"{{lang 'common.channel_switch_warning'}}\">\n                        {{#if is_active}}\n                            <strong>{{name}}</strong>\n                        {{else}}\n                            {{name}}\n                        {{/if}}\n                    </a>\n                </li>\n            {{/each}}\n        </ul>\n    </li>\n</ul>\n{{/if}}\n","components/common/currency-selector":"{{#if currency_selector.currencies.length '>' 1}}\n<ul class=\"navUser-section\">\n    <li class=\"navUser-item\">\n        <a class=\"navUser-action navUser-action--currencySelector has-dropdown\"\n           href=\"#\"\n           data-dropdown=\"currencySelection\"\n           aria-controls=\"currencySelection\"\n           aria-expanded=\"false\"\n        >\n            <span class=\"is-srOnly\">{{lang 'common.currency' code=currency_selector.active_currency_code}}</span>\n            <span aria-hidden=\"true\">{{currency_selector.active_currency_code}}</span>\n        </a>\n        <ul class=\"dropdown-menu\" id=\"currencySelection\" data-dropdown-content aria-hidden=\"true\" tabindex=\"-1\">\n            {{#each currency_selector.currencies}}\n            <li class=\"dropdown-menu-item\">\n                <a href=\"{{{switch_url}}}\"\n                   data-currency-code=\"{{{code}}}\"\n                   {{#if cart_currency_switch_url.length '>' 0 }}\n                   data-cart-currency-switch-url=\"{{{cart_currency_switch_url}}}\"\n                   {{/if}}\n                   data-warning=\"{{lang 'common.currency_switch_promotion'}}\"\n                >\n                {{#if is_active}}\n                    <strong>{{name}}</strong>\n                {{else}}\n                    {{name}}\n                {{/if}}\n                </a>\n            </li>\n            {{/each}}\n        </ul>\n    </li>\n</ul>\n{{/if}}\n","components/common/header":"<a href=\"#main-content\" class=\"skip-to-main-link\">Skip to main content</a>\n{{#if banners.top}}\n<div class=\"banners\" data-banner-location=\"top\">\n    {{#each (limit banners.top_metadata 1)}}\n    <div class=\"banner\" data-event-type=\"promotion\" data-entity-id=\"{{this.id}}\" data-name=\"{{this.banner-name}}\" data-position=\"{{this.location}}\" data-banner-id=\"{{this.banner-name}}\">\n        <div data-event-type=\"promotion-click\">\n            {{{this.content}}}\n        </div>\n    </div>\n    {{/each}}\n</div>\n{{/if}}\n<header class=\"header twelve-header\" role=\"banner\">\n    {{> components/common/twelve-announcement}}\n    <div class=\"twelve-masthead\">\n    <div class=\"twelve-desktop-menu-slot\" data-twelve-desktop-menu-slot>\n        {{> components/common/twelve-navigation}}\n    </div>\n    <a href=\"#menu\" class=\"mobileMenu-toggle\" data-mobile-menu-toggle=\"menu\" aria-label=\"Toggle menu\" aria-expanded=\"false\" aria-controls=\"menu\">\n        <span class=\"mobileMenu-toggleIcon\">Toggle menu</span>\n    </a>\n    {{> components/common/navigation}}\n\n    {{#if page_type '===' 'default'}}\n        <h1 class=\"header-logo header-logo--{{theme_settings.logo-position}}\">\n            {{> components/common/store-logo}}\n        </h1>\n    {{else}}\n        <div class=\"header-logo header-logo--{{theme_settings.logo-position}}\">\n            {{> components/common/store-logo}}\n        </div>\n    {{/if}}\n    </div>\n    <div class=\"navPages-container twelve-mobile-drawer\" id=\"menu\" data-menu role=\"dialog\" aria-modal=\"true\" aria-label=\"Menu\">\n        {{> components/common/navigation-menu}}\n    </div>\n    {{{region name=\"header_navigation_bottom--global\"}}}\n</header>\n{{{region name=\"header_bottom--global\"}}}\n{{{region name=\"header_bottom\"}}}\n","components/common/language-selector":"<ul class=\"navUser-section\">\n    <li class=\"navUser-item\">\n        <a class=\"navUser-action navUser-action--languageSelector has-dropdown\"\n           href=\"#\"\n           data-locale-code=\"{{language_selector.active_language_code}}\"\n           data-dropdown=\"languageSelection\"\n           aria-controls=\"languageSelection\"\n           aria-expanded=\"false\"\n           aria-label=\"{{language_selector.active_language_code}}\"\n        >\n            <span>\n                {{#unless compact}}{{lang 'common.locale'}} {{/unless}}<strong>{{language_selector.active_language_code}}</strong>\n            </span>\n            <i class=\"icon\" aria-hidden=\"true\">\n                <svg>\n                    <use href=\"#icon-chevron-down\" />\n                </svg>\n            </i>\n        </a>\n        <ul class=\"dropdown-menu\" id=\"languageSelection\" data-dropdown-content aria-hidden=\"true\" tabindex=\"-1\">\n            {{#each language_selector.languages}}\n                <li class=\"dropdown-menu-item\">\n                    <a href=\"{{switch_url}}\"\n                       data-locale-code=\"{{code}}\"\n                       data-warning=\"{{lang 'common.locale_switch_warning'}}\"\n                       aria-label=\"{{code}}\"\n                    >\n                        {{#if is_active}}\n                            <strong>{{code}}</strong>\n                        {{else}}\n                            {{code}}\n                        {{/if}}\n                    </a>\n                </li>\n            {{/each}}\n        </ul>\n    </li>\n</ul>\n","components/common/navigation":"<nav class=\"navUser twelve-tools\" aria-label=\"Customer tools\">\n    <ul class=\"navUser-section navUser-section--alt\">\n        <li class=\"navUser-item\">\n            <button class=\"navUser-action twelve-tool\" type=\"button\" id=\"quick-search-expand\" data-search=\"quickSearch\" aria-controls=\"quickSearch\" aria-expanded=\"false\" aria-label=\"Search\">\n                <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"6.5\"/><path d=\"M16 16l4.5 4.5\"/></svg>\n            </button>\n        </li>\n        <li class=\"navUser-item twelve-tool-desktop\">\n            <a class=\"navUser-action twelve-tool\" href=\"{{#if customer}}{{urls.account.index}}{{else}}{{urls.auth.login}}{{/if}}\" aria-label=\"Account\">\n                <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"8.5\" r=\"3.8\"/><path d=\"M4.8 20a7.2 7.2 0 0 1 14.4 0\"/></svg>\n            </a>\n        </li>\n        \n        <li class=\"navUser-item twelve-tool-desktop\">\n            <a class=\"navUser-action twelve-tool\" href=\"/?auth={{random 150 10}}-{{random 125 10}}#/shoppingLists\" aria-label=\"Wish Lists\">\n                <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M20.5 5.8c-2-2.1-5.4-1.8-8.5 1.3C8.9 4 5.5 3.7 3.5 5.8c-3.8 4 1.1 10 8.5 15 7.4-5 12.3-11 8.5-15Z\"/></svg>\n            </a>\n        </li>\n        \n        <li class=\"navUser-item navUser-item--cart\">\n            <a class=\"navUser-action twelve-tool\" data-cart-preview href=\"{{urls.cart}}\" aria-controls=\"cart-preview-dropdown\" aria-expanded=\"false\" aria-label=\"Cart with 0 items\">\n                <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 7h14l-1.2 13H6.2z\"/><path d=\"M9 9V6a3 3 0 0 1 6 0v3\"/></svg>\n                <span class=\"countPill cart-quantity\"></span>\n            </a>\n            <div class=\"twelve-cart-scrim\" data-twelve-cart-scrim></div>\n            <div class=\"dropdown-menu\" id=\"cart-preview-dropdown\" aria-hidden=\"true\"></div>\n        </li>\n    </ul>\n    <div class=\"dropdown dropdown--quickSearch\" id=\"quickSearch\" aria-hidden=\"true\" data-prevent-quick-search-close>\n        {{> components/common/quick-search name='nav-quick-search'}}\n    </div>\n</nav>\n","components/common/navigation-menu":"<div class=\"twelve-mobile-top\">\n    <div class=\"twelve-mobile-logo\">{{> components/common/store-logo}}</div>\n    <button class=\"twelve-mobile-close\" type=\"button\" data-twelve-mobile-close aria-label=\"Close menu\">\n        <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6 6 18\"/></svg>\n    </button>\n</div>\n\n{{!-- The one dynamic navigation is moved into this slot on mobile. --}}\n<div class=\"twelve-mobile-body\" data-twelve-mobile-menu-slot></div>\n\n<div class=\"twelve-mobile-footer\">\n    <div class=\"twelve-mobile-selectors\">\n        {{#and language_selector language_selector.languages.length '>' 1}}\n            <details class=\"twelve-mobile-select\">\n                <summary aria-label=\"Language\"><span data-locale-code=\"{{language_selector.active_language_code}}\">{{language_selector.active_language_code}}</span></summary>\n                <ul>{{#each language_selector.languages}}<li><a href=\"{{switch_url}}\" data-locale-code=\"{{code}}\" {{#if is_active}}aria-current=\"true\"{{/if}}>{{code}}</a></li>{{/each}}</ul>\n            </details>\n        {{else}}\n            <span class=\"twelve-mobile-locale\">English</span>\n        {{/and}}\n        {{#or customer (unless settings.hide_price_from_guests)}}\n            {{#if currency_selector.currencies.length '>' 1}}\n                <details class=\"twelve-mobile-select\">\n                    <summary aria-label=\"Currency\">{{currency_selector.active_currency_code}}</summary>\n                    <ul>{{#each currency_selector.currencies}}<li><a href=\"{{{switch_url}}}\" data-currency-code=\"{{code}}\" {{#if cart_currency_switch_url}}data-cart-currency-switch-url=\"{{{cart_currency_switch_url}}}\"{{/if}} data-warning=\"Changing currency may affect your promotions. Continue?\" {{#if is_active}}aria-current=\"true\"{{/if}}>{{code}}</a></li>{{/each}}</ul>\n                </details>\n            {{else}}<span class=\"twelve-mobile-locale\">{{currency_selector.active_currency_code}}</span>{{/if}}\n        {{/or}}\n    </div>\n    <span class=\"twelve-mobile-cities\">NY &middot; LDN &middot; PAR</span>\n</div>\n","components/common/quick-search":"<div class=\"twelve-search-overlay\" data-pre-load=\"box\">\n    <form class=\"form\" data-url=\"{{urls.search}}\" data-quick-search-form>\n        <fieldset class=\"form-fieldset\">\n            <div class=\"form-field\">\n                <label class=\"is-srOnly\" for=\"{{name}}\">{{lang \"search.quick_search.input_label\"}}</label>\n                <svg class=\"twelve-search-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"6.5\"/><path d=\"M16 16l4.5 4.5\"/></svg>\n                <input class=\"form-input\"\n                       data-search-quick\n                       name=\"{{name}}\"\n                       id=\"{{name}}\"\n                       data-error-message=\"{{lang 'search.error.empty_field'}}\"\n                       placeholder=\"What are you making?\"\n                       autocomplete=\"off\"\n                >\n                <button class=\"twelve-search-close\" type=\"button\" data-drop-down-close aria-label=\"Close search\"><span aria-hidden=\"true\">&times;</span></button>\n            </div>\n        </fieldset>\n    </form>\n    <div class=\"twelve-search-content\">\n        <aside class=\"twelve-search-popular\">\n            <span class=\"twelve-search-label\">Popular</span>\n            <div class=\"twelve-search-tags\">\n                <button type=\"button\" data-twelve-search-term=\"Canvas tote\">Canvas tote</button>\n                <button type=\"button\" data-twelve-search-term=\"Rigid box\">Rigid box</button>\n                <button type=\"button\" data-twelve-search-term=\"Bottle\">Bottle</button>\n                <button type=\"button\" data-twelve-search-term=\"Ornament\">Ornament</button>\n                <button type=\"button\" data-twelve-search-term=\"Gift kit\">Gift kit</button>\n            </div>\n        </aside>\n        <div class=\"twelve-search-products\">\n            <p class=\"twelve-search-products-title\" data-twelve-search-title>Products · <em>Popular right now</em></p>\n            <div class=\"loadingOverlay\" data-twelve-search-loading style=\"display: none;\">&nbsp;</div>\n            <section class=\"quickSearchResults\" data-bind=\"html: results\"></section>\n        </div>\n    </div>\n    <p role=\"status\"\n       aria-live=\"polite\"\n       class=\"aria-description--hidden\"\n       data-search-aria-message-predefined-text=\"{{{lang 'search.results.quick_count_live'}}}\"\n    ></p>\n</div>\n","components/common/store-logo":"<a href=\"{{urls.home}}\" class=\"header-logo__link\" data-header-logo-link>\n    {{#if settings.store_logo.image}}\n        {{#if theme_settings.logo_size '===' 'original'}}\n        <img class=\"header-logo-image-unknown-size\"\n             src=\"{{getImage settings.store_logo.image 'logo_size'}}\"\n             alt=\"{{settings.store_logo.title}}\"\n             title=\"{{settings.store_logo.title}}\">\n        {{else}}\n        <div class=\"header-logo-image-container\">\n            <img class=\"header-logo-image\"\n                 src=\"{{getImage settings.store_logo.image 'logo_size'}}\"\n                 srcset=\"{{getImageSrcset1x2x settings.store_logo.image theme_settings.logo_size}}\"\n                 alt=\"{{settings.store_logo.title}}\"\n                 title=\"{{settings.store_logo.title}}\">\n        </div>\n        {{/if}}\n    {{else}}\n        {{#if theme_settings.twelve_use_wordmark}}\n            <img class=\"twelve-wordmark\" src=\"{{cdn 'assets/img/twelve-wordmark.png'}}\" width=\"900\" height=\"176\" alt=\"{{settings.store_logo.title}}\">\n        {{else}}\n            <span class=\"header-logo-text\">{{settings.store_logo.title}}</span>\n        {{/if}}\n    {{/if}}\n</a>\n","components/common/twelve-announcement":"<div class=\"twelve-announcement\">\n    <div class=\"twelve-announcement-inner\">\n        <div class=\"twelve-announcement-message\">\n            {{{region name=\"header_announcement--global\"}}}\n        </div>\n        <nav class=\"twelve-localization\" aria-label=\"{{lang 'header.store_preferences'}}\">\n\n\n            <div>\n                {{#if (getVar \"globalCustomerRegion\") '==' 'EUKEM'}}\n                    <a class=\"connect-with-us tooltip_hover_state\" href=\"mailto:ELC_EUKEM@twelvenyc.com\">\n                        <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" width=\"22\" height=\"22\"><path d=\"M3 6h18v12H3z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"></path><path d=\"M3 7l9 6 9-6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"></path></svg>\n                        <span>{{lang 'social.connect'}}</span>\n                        <div class=\"tooltip_content_box\">\n                            <p>ELC_EUKEM@twelvenyc.com</p>\n                        </div>\n                    </a>\n                {{else}}\n                    <a class=\"connect-with-us tooltip_hover_state\" href=\"mailto:ELC_NACR_GLOBAL@twelvenyc.com\">\n                        <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" width=\"22\" height=\"22\"><path d=\"M3 6h18v12H3z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"></path><path d=\"M3 7l9 6 9-6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"></path></svg>\n                        <span>{{lang 'social.connect'}}</span>\n                        <div class=\"tooltip_content_box\">\n                            <p>ELC_NACR_GLOBAL@twelvenyc.com</p>\n                        </div>\n                    </a>\n                {{/if}}\n            </div>\n\n            <div class=\"twelve-localization-group\">\n                <span class=\"twelve-localization-label\">{{lang 'header.language'}}</span>\n                {{#and language_selector language_selector.languages.length '>' 1}}\n                    {{> components/common/language-selector compact=true}}\n                {{else}}\n                    <span class=\"twelve-language-static\">{{lang 'header.language_code'}}</span>\n                {{/and}}\n            </div>\n            {{#or customer (unless settings.hide_price_from_guests)}}\n                <div class=\"twelve-localization-group\">\n                    <span class=\"twelve-localization-label\">{{lang 'header.currency'}}</span>\n                    {{> components/common/currency-selector}}\n                </div>\n            {{/or}}\n            {{#if theme_settings.show_channels}}{{> components/common/channel-selector}}{{/if}}\n            {{#if customer}}\n                <a href=\"{{urls.account.index}}\">{{lang 'common.account'}}</a>\n                <a href=\"{{urls.auth.logout}}\">{{lang 'common.logout'}}</a>\n            {{else}}\n                <a href=\"{{urls.auth.login}}\">{{lang 'common.login'}}</a>\n                <a class=\"open-signup-popup\" href=\"javascript:void(0)\">{{lang 'common.sign_up'}}</a>\n            {{/if}}\n        </nav>\n    </div>\n</div>\n","components/common/twelve-category-link":"<a href=\"{{url}}\" data-account-category-id=\"{{id}}\" {{#if is_active}}aria-current=\"page\"{{/if}}>{{name}}</a>\n{{#if children}}<ul>{{#each children}}<li>{{> components/common/twelve-category-link}}</li>{{/each}}</ul>{{/if}}\n","components/common/twelve-navigation":"<nav class=\"twelve-navigation\" aria-label=\"{{lang 'header.navigation.primary'}}\">\n    <ul class=\"twelve-nav-list\">\n        {{#each categories}}\n            <li class=\"twelve-nav-item\" nav-item=\"{{snakecase (lowercase name)}}\" data-account-category-id=\"{{id}}\"{{#if name '===' 'Brands'}} data-account-brands-menu{{/if}}>\n                {{#if name '===' 'Brands'}}\n                    {{#if ../shop_by_brand}}\n                        <details class=\"twelve-menu\">\n                            <summary>{{name}}<span class=\"twelve-chevron\" aria-hidden=\"true\"></span></summary>\n                            <div class=\"twelve-mega\">\n                                <div class=\"twelve-mega-inner twelve-mega-brands\">\n                                    <ul class=\"twelve-brand-list\" data-alphabetize-brands>\n                                        {{#each ../shop_by_brand}}<li><a href=\"{{url}}\" data-account-brand-id=\"{{id}}\">{{name}}</a></li>{{/each}}\n                                    </ul>\n                                    <aside class=\"twelve-mega-all twelve-mega-brand-promo\">\n                                        <span class=\"twelve-eyebrow\">{{lang 'header.navigation.brand_heading'}}</span>\n                                        <p>{{lang 'header.navigation.brand_description'}}</p>\n                                        <a class=\"twelve-text-link\" href=\"/brands/\">{{lang 'header.navigation.browse_all_products'}} <span aria-hidden=\"true\">&rarr;</span></a>\n                                    </aside>\n                                </div>\n                            </div>\n                        </details>\n                    {{else}}\n                        <a class=\"twelve-nav-link\" href=\"{{url}}\">{{name}}</a>\n                    {{/if}}\n                {{else}}\n                    {{#if children}}\n                        <details class=\"twelve-menu\">\n                            <summary>{{name}}<span class=\"twelve-chevron\" aria-hidden=\"true\"></span></summary>\n                            <div class=\"twelve-mega\">\n                                <div class=\"twelve-mega-inner\">\n                                    {{#each children}}\n                                        <details class=\"twelve-mega-column twelve-category-group\" data-account-category-id=\"{{id}}\">\n                                            <summary><a href=\"{{url}}\" data-account-category-id=\"{{id}}\">{{name}}</a><span class=\"twelve-plus\" aria-hidden=\"true\"></span></summary>\n                                            <ul>\n                                                <li class=\"twelve-category-all\"><a href=\"{{url}}\">{{lang 'header.navigation.shop_all' name=name}} &rarr;</a></li>\n                                                {{#each children}}<li>{{> components/common/twelve-category-link}}</li>{{/each}}\n                                            </ul>\n                                        </details>\n                                    {{/each}}\n                                    <aside class=\"twelve-mega-all\">\n                                        <span class=\"twelve-eyebrow\">{{lang 'header.navigation.everything_else'}}</span>\n                                        <a class=\"twelve-all-link\" href=\"/shop/\"><span>{{lang 'header.navigation.all_shop_categories'}}</span></a>\n                                    </aside>\n                                </div>\n                            </div>\n                        </details>\n                    {{else}}\n                        <a class=\"twelve-nav-link{{#if is_active}} activePage{{/if}}\" href=\"{{url}}\" data-account-category-id=\"{{id}}\" {{#if is_active}}aria-current=\"page\"{{/if}}>{{name}}</a>\n                    {{/if}}\n                {{/if}}\n            </li>\n        {{/each}}\n        {{#unless theme_settings.hide_content_navigation}}\n            {{#each pages}}<li class=\"twelve-nav-item\" nav-item=\"{{snakecase (lowercase name)}}\"><a class=\"twelve-nav-link\" href=\"{{url}}\">{{name}}</a></li>{{/each}}\n        {{/unless}}\n    </ul>\n    <div class=\"twelve-mobile-secondary\">\n        {{#if customer}}\n            <a href=\"{{urls.account.index}}\">{{lang 'header.navigation.my_account'}}</a>\n            <a href=\"{{urls.auth.logout}}\">{{lang 'common.logout'}}</a>\n        {{else}}\n            <a href=\"{{urls.auth.login}}\">{{lang 'common.login'}}</a>\n            <a class=\"open-signup-popup\" href=\"javascript:void(0)\">{{lang 'common.sign_up'}}</a>\n        {{/if}}\n        <a href=\"/?auth={{random 150 10}}-{{random 125 10}}#/shoppingLists\">{{lang 'header.navigation.my_list'}}</a>\n    </div>\n</nav>\n"}