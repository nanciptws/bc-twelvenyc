{"components/products/twelve-wishlist":"<form action=\"{{product.add_to_wishlist_url}}\" class=\"form form-wishlist form-action\" data-wishlist-add method=\"post\">\n    <a aria-controls=\"wishlist-dropdown\"\n       aria-expanded=\"false\"\n       class=\"button dropdown-menu-button\"\n       data-dropdown=\"wishlist-dropdown\"\n       href=\"#\"\n    >\n        <span class=\"is-srOnly\">{{lang 'account.wishlists.add_item'}}</span>\n        <i aria-hidden=\"true\" class=\"icon\">\n            <svg viewBox=\"0 0 24 24\"><path d=\"M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z\"/></svg>\n        </i>\n    </a>\n    <ul aria-hidden=\"true\" class=\"dropdown-menu\" data-dropdown-content id=\"wishlist-dropdown\">\n        {{#if customer.wishlists}}\n            {{#each customer.wishlists}}\n                <li>\n                    <input class=\"button {{#if this.num_items '!==' '0'}}button--has-items{{/if}}\"\n                           formaction=\"{{this.add_url}}&product_id={{../product.id}}\"\n                           type=\"submit\"\n                           value=\"{{this.name}}\"\n                    >\n                </li>\n            {{/each}}\n        {{else}}\n        <li>\n            <input class=\"button\" type=\"submit\" value=\"{{lang 'account.wishlists.add_to_default'}}\">\n        </li>\n        {{/if}}\n        <li>\n            <a data-wishlist class=\"button\" href=\"/wishlist.php?action=addwishlist&product_id={{product.id}}\">{{lang 'account.wishlists.create_new'}}</a>\n        </li>\n    </ul>\n</form>\n"}