{"components/common/twelve-category-link":"<a href=\"{{url}}\" data-account-category-id=\"{{id}}\" {{#if is_active}}aria-current=\"page\"{{/if}}>{{name}}</a>\n{{#if children}}<ul>{{#each children}}<li>{{> components/common/twelve-category-link}}</li>{{/each}}</ul>{{/if}}\n","components/common/twelve-navigation":"<nav class=\"twelve-navigation\" aria-label=\"{{lang 'header.navigation.primary'}}\">\n    <ul class=\"twelve-nav-list\">\n        {{#each categories}}\n            <li class=\"twelve-nav-item\" nav-item=\"{{snakecase (lowercase name)}}\" data-account-category-id=\"{{id}}\"{{#if name '===' 'Brands'}} data-account-brands-menu{{/if}}>\n                {{#if name '===' 'Brands'}}\n                    {{#if ../shop_by_brand}}\n                        <details class=\"twelve-menu\">\n                            <summary>{{name}}<span class=\"twelve-chevron\" aria-hidden=\"true\"></span></summary>\n                            <div class=\"twelve-mega\">\n                                <div class=\"twelve-mega-inner twelve-mega-brands\">\n                                    <ul class=\"twelve-brand-list\" data-alphabetize-brands>\n                                        {{#each ../shop_by_brand}}<li><a href=\"{{url}}\" data-account-brand-id=\"{{id}}\">{{name}}</a></li>{{/each}}\n                                    </ul>\n                                    <aside class=\"twelve-mega-all twelve-mega-brand-promo\">\n                                        <span class=\"twelve-eyebrow\">{{lang 'header.navigation.brand_heading'}}</span>\n                                        <p>{{lang 'header.navigation.brand_description'}}</p>\n                                        <a class=\"twelve-text-link\" href=\"/brands/\">{{lang 'header.navigation.browse_all_products'}} <span aria-hidden=\"true\">&rarr;</span></a>\n                                    </aside>\n                                </div>\n                            </div>\n                        </details>\n                    {{else}}\n                        <a class=\"twelve-nav-link\" href=\"{{url}}\">{{name}}</a>\n                    {{/if}}\n                {{else}}\n                    {{#if children}}\n                        <details class=\"twelve-menu\">\n                            <summary>{{name}}<span class=\"twelve-chevron\" aria-hidden=\"true\"></span></summary>\n                            <div class=\"twelve-mega\">\n                                <div class=\"twelve-mega-inner\">\n                                    {{#each children}}\n                                        <details class=\"twelve-mega-column twelve-category-group\" data-account-category-id=\"{{id}}\">\n                                            <summary><a href=\"{{url}}\" data-account-category-id=\"{{id}}\">{{name}}</a><span class=\"twelve-plus\" aria-hidden=\"true\"></span></summary>\n                                            <ul>\n                                                <li class=\"twelve-category-all\"><a href=\"{{url}}\">{{lang 'header.navigation.shop_all' name=name}} &rarr;</a></li>\n                                                {{#each children}}<li>{{> components/common/twelve-category-link}}</li>{{/each}}\n                                            </ul>\n                                        </details>\n                                    {{/each}}\n                                    <aside class=\"twelve-mega-all\">\n                                        <span class=\"twelve-eyebrow\">{{lang 'header.navigation.everything_else'}}</span>\n                                        <a class=\"twelve-all-link\" href=\"/shop/\"><span>{{lang 'header.navigation.all_shop_categories'}}</span></a>\n                                    </aside>\n                                </div>\n                            </div>\n                        </details>\n                    {{else}}\n                        <a class=\"twelve-nav-link{{#if is_active}} activePage{{/if}}\" href=\"{{url}}\" data-account-category-id=\"{{id}}\" {{#if is_active}}aria-current=\"page\"{{/if}}>{{name}}</a>\n                    {{/if}}\n                {{/if}}\n            </li>\n        {{/each}}\n        {{#unless theme_settings.hide_content_navigation}}\n            {{#each pages}}<li class=\"twelve-nav-item\" nav-item=\"{{snakecase (lowercase name)}}\"><a class=\"twelve-nav-link\" href=\"{{url}}\">{{name}}</a></li>{{/each}}\n        {{/unless}}\n    </ul>\n    <div class=\"twelve-mobile-secondary\">\n        {{#if customer}}\n            <a href=\"{{urls.account.index}}\">{{lang 'header.navigation.my_account'}}</a>\n            <a href=\"{{urls.auth.logout}}\">{{lang 'common.logout'}}</a>\n        {{else}}\n            <a href=\"{{urls.auth.login}}\">{{lang 'common.login'}}</a>\n            <a class=\"open-signup-popup\" href=\"javascript:void(0)\">{{lang 'common.sign_up'}}</a>\n        {{/if}}\n        <a href=\"/?auth={{random 150 10}}-{{random 125 10}}#/shoppingLists\">{{lang 'header.navigation.my_list'}}</a>\n    </div>\n</nav>\n"}